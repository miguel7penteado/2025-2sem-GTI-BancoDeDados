library(plantuml)
# Define a plantuml object
puml_code <- "
@startuml
Alice -> Bob: Hello
@enduml
"
puml_obj <- plantuml(puml_code)
# Plot to a file (e.g., PNG)
plot(puml_obj, file = "hello.png")
