# Caminho para o plantuml.jar
plantuml_jar <- "C:\\Program Files\\Common Files\\Oracle\\Java\\libs\\plantuml-1.2025.4.jar"
# Nome temporário do arquivo .uml
uml_file <- tempfile(fileext = ".uml")
# Escreve no arquivo "uml_file" o conteudo de "code"
writeLines(code, uml_file)
# Executa o PlantUML
system2("java", c("-jar", shQuote(plantuml_jar), shQuote(uml_file)))
# Retorna a imagem gerada
knitr::include_graphics(sub("\\.uml$", ".png", uml_file))
})
