library(plantuml)
# Define a plantuml object
puml_code <- "
@startchen
left to right direction
entity Person {
}
entity Location {
}
relationship Birthplace {
}
Person -N- Birthplace
Birthplace -1- Location
@endchen
"
puml_obj <- plantuml(puml_code)
# Plot to a file (e.g., PNG)
plot(puml_obj, file = "hello.png")
